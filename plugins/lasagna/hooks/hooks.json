{
  "description": "lasagna guardrails, only where a mechanical truth is needed: the implementer may neither write nor read tests, the test-writer may not read production code during tdd-loop, test outcomes are captured from real runs, cycles are counted per criterion, and phase state is pinned before compaction and shown at session start. Every hook exits quietly in projects that do not use lasagna, and each can be switched off via hooks_disabled in the stack profile. Requires Python >= 3.9 (standard library only).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook session-status",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook block-test-edits",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Read|Grep|Glob|Bash|NotebookRead)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook block-reads",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook capture-test-result",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^plugin:lasagna:(test-writer|implementer|referee)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook count-cycle",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook dump-phase-state",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
